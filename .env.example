# =============================================================
# PUM Web — variables de entorno
# Copiar a .env y completar. Nunca versionar el .env real.
# =============================================================

# ── Base de datos ────────────────────────────────────────────
# Obligatoria. PostgreSQL 15+.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/pum

# Opcionales (valores por defecto entre paréntesis)
# DATABASE_POOL_MAX=10                  # conexiones máximas del pool (10)
# DATABASE_STATEMENT_TIMEOUT_MS=30000   # Postgres cancela consultas más largas (30 s)
# DATABASE_APP_NAME=pum-web             # nombre visible en pg_stat_activity
# PRISMA_LOG_QUERIES=false              # true: registra cada consulta (solo para depurar)

# ── Autenticación ────────────────────────────────────────────
# Obligatoria en producción: mínimo 32 caracteres aleatorios.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# URL pública de la app. En producción debe ser el dominio real (detrás del
# túnel): la usan los redirects y la política de seguridad de contenido.
AUTH_URL=http://localhost:3000

# Duración deslizante de la sesión en segundos (8 h). Además, toda sesión
# expira a las 12 h del login.
# SESSION_MAX_AGE=28800

# Solo desarrollo: habilita las cuentas de prueba (docente@test.com, etc.).
# Ignorada cuando NODE_ENV=production.
# ENABLE_DEV_USERS=true

# ── Institución ──────────────────────────────────────────────
INSTITUTION_NAME="Unidad Educativa"
# INSTITUTION_SUBNAME=""                # segunda línea del encabezado de la vista previa

# ── Retención de registros (días) ────────────────────────────
# USER_AUDIT_RETENTION_DAYS=730         # auditoría de usuarios y accesos (2 años)
# ERROR_LOG_RETENTION_DAYS=180          # log de errores del sistema (6 meses)
# El historial de cada PUM (plan_audit_events) no se purga.

# ── Registro ─────────────────────────────────────────────────
# LOG_LEVEL=info                        # debug | info | warn | error
# DEBUG=false                           # true: detalles extra en respuestas de error

# ── Pruebas ──────────────────────────────────────────────────
# Base DESECHABLE para `npm run test:integration` (se vacía en cada corrida).
# TEST_DATABASE_URL=postgresql://usuario:clave@localhost:5432/pum_test
