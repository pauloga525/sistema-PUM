// =============================================================
// Schema Prisma — PUM Web
// Motor: PostgreSQL 15+
// ORM: Prisma 7.x
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// =============================================================
// ENUMS
// =============================================================

enum Role {
  TEACHER
  COORDINATOR
  ADMIN
  SUPERADMIN
}

// Ciclo de vida del PUM. Las transiciones válidas están en
// PLAN_TRANSITIONS (src/modules/planification/planification.domain.ts).
enum PlanStatus {
  DRAFT
  FINALIZED
  FEEDBACK_RECEIVED
  APPROVED
  PENDING_SIGNATURE
  SIGNED
  ADMIN_REJECTED
}

enum ReviewStatus {
  IN_REVIEW
  FEEDBACK_SENT
  APPROVED
}

enum LevelTrack {
  BASICA
  BACHILLERATO
}

// =============================================================
// USUARIOS
// =============================================================

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role                  Role      @default(TEACHER)
  cedula                String?   @unique
  passwordHash          String?
  forcePasswordChange   Boolean   @default(false)
  // Vencimiento de la contraseña temporal (creación/restablecimiento); null = contraseña propia
  tempPasswordExpiresAt DateTime?
  coordinatorArea       String?
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?

  assignments        TeacherAssignment[]
  planificationLinks PlanificationTeacher[]

  coordinatorAssignmentsAsCoordinator CoordinatorAssignment[]        @relation("CoordinatorTeachers")
  coordinatorAssignmentsAsTeacher     CoordinatorAssignment[]        @relation("TeacherCoordinators")
  coordinatedAssignments              TeacherAssignment[]            @relation("AssignmentCoordinator")
  coordinatorSubjectLinks             CoordinatorSubjectAssignment[] @relation("CoordinatorSubjects")
  planReviews                         PlanReview[]                   @relation("CoordinatorReviews")
  auditEvents                         PlanAuditEvent[]               @relation("AuditActor")
  userAuditLogsAsActor                UserAuditLog[]                 @relation("UserAuditActor")
  userAuditLogsAsTarget               UserAuditLog[]                 @relation("UserAuditTarget")
  maintenanceToggles                  SystemSetting[]                @relation("MaintenanceEnabledBy")
  resolvedErrors                      SystemErrorLog[]               @relation("ErrorResolvedBy")

  @@index([role])
  @@map("users")
}

// =============================================================
// DOMINIO — Estructura académica
// =============================================================

model AcademicYear {
  id        String    @id @default(uuid())
  label     String    @unique // "2026-2027"
  yearStart Int // 2026
  active    Boolean   @default(true)
  startDate DateTime? // Fecha de inicio del año lectivo
  endDate   DateTime? // Fecha de fin del año lectivo
  createdAt DateTime  @default(now())

  periods        Period[]
  assignments    TeacherAssignment[]
  planifications Planification[]

  @@map("academic_years")
}

model Period {
  id             String    @id @default(uuid())
  name           String // "Quimestre 1"
  number         Int // 1, 2, 3...
  academicYearId String
  startDate      DateTime? // Fecha de inicio del periodo
  endDate        DateTime? // Fecha de fin del periodo
  createdAt      DateTime  @default(now())

  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  planifications Planification[]
  assignments    TeacherAssignment[]

  @@unique([academicYearId, number])
  @@map("periods")
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique // "MAT", "LEN", "CCNN"
  areaEstudio String?
  createdAt   DateTime @default(now())

  assignments             TeacherAssignment[]
  planifications          Planification[]
  subjectLevels           SubjectLevel[]
  coordinatorSubjectLinks CoordinatorSubjectAssignment[]

  @@map("subjects")
}

model Level {
  id         String     @id @default(uuid())
  name       String // "3ro de Bachillerato"
  code       String     @unique // "3BGU"
  orderIndex Int
  track      LevelTrack
  createdAt  DateTime   @default(now())

  assignments    TeacherAssignment[]
  planifications Planification[]
  subjectLevels  SubjectLevel[]

  @@map("levels")
}

// Relación muchos-a-muchos entre Materia y Nivel
// Permite definir qué materias se dictan en cada nivel educativo
model SubjectLevel {
  id        String   @id @default(uuid())
  subjectId String
  levelId   String
  createdAt DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level   Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([subjectId, levelId])
  @@map("subject_levels")
}

// =============================================================
// DOMINIO — Asignaciones y planificaciones
// =============================================================

model TeacherAssignment {
  id              String   @id @default(uuid())
  teacherId       String
  subjectId       String
  levelId         String
  academicYearId  String
  periodId        String? // Periodo específico, null = todos los periodos
  coordinatorId   String? // Coordinador responsable de esta asignación
  isPrimaryEditor Boolean  @default(false) // Docente designado como editor principal del PUM
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  level        Level        @relation(fields: [levelId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  period       Period?      @relation(fields: [periodId], references: [id], onDelete: SetNull)
  coordinator  User?        @relation("AssignmentCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)

  // Una asignación por docente+materia+nivel+año. periodId es informativo:
  // el acceso del docente abarca todos los periodos del año.
  @@unique([teacherId, subjectId, levelId, academicYearId])
  @@index([teacherId, academicYearId, active])
  @@index([subjectId, levelId, academicYearId, active])
  @@index([coordinatorId])
  @@map("teacher_assignments")
}

model Planification {
  id             String @id @default(uuid())
  academicYearId String
  periodId       String
  subjectId      String
  levelId        String

  status         PlanStatus @default(DRAFT)
  editDeadlineAt DateTime?
  finalizedAt    DateTime?
  clonedFromId   String?
  metadata       Json?

  // Último rechazo del administrador (se limpia al reenviar a firma)
  adminRejectionComment String?   @db.Text
  adminRejectedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYear AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  period       Period          @relation(fields: [periodId], references: [id], onDelete: Restrict)
  subject      Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  level        Level           @relation(fields: [levelId], references: [id], onDelete: Restrict)
  clonedFrom   Planification?  @relation("PlanClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones       Planification[] @relation("PlanClone")

  teachers    PlanificationTeacher[]
  rows        PlanificationRow[]
  review      PlanReview?
  auditEvents PlanAuditEvent[]

  @@unique([academicYearId, periodId, subjectId, levelId])
  @@index([academicYearId, periodId])
  @@index([academicYearId, status])
  @@index([subjectId, levelId, academicYearId])
  @@map("planifications")
}

// Relación M2M entre docentes y planificaciones.
// isEditor = true para el docente que creó el PUM (único editor, garantizado
// por el índice único parcial planification_teachers_single_editor).
// Los demás docentes vinculados tienen isEditor = false (solo lectura/consulta).
model PlanificationTeacher {
  id              String   @id @default(uuid())
  planificationId String
  teacherId       String
  isEditor        Boolean  @default(false)
  joinedAt        DateTime @default(now())

  planification Planification @relation(fields: [planificationId], references: [id], onDelete: Cascade)
  teacher       User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([planificationId, teacherId])
  @@unique([planificationId], where: { isEditor: true }, map: "planification_teachers_single_editor")
  @@index([teacherId])
  @@map("planification_teachers")
}

model PlanificationRow {
  id              String @id @default(uuid())
  planificationId String
  rowIndex        Int

  data             Json
  methodologyIcons Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planification Planification @relation(fields: [planificationId], references: [id], onDelete: Cascade)

  @@unique([planificationId, rowIndex])
  @@map("planification_rows")
}

// =============================================================
// COORDINADOR DE ÁREA — Retroalimentación de PUMs
// =============================================================

// Materias que el admin habilitó para un coordinador.
// El coordinador solo puede asignar estas materias a sus docentes.
// Si no hay registros para un coordinador → puede usar todas (retrocompat).
model CoordinatorSubjectAssignment {
  id            String   @id @default(uuid())
  coordinatorId String
  subjectId     String
  createdAt     DateTime @default(now())

  coordinator User    @relation("CoordinatorSubjects", fields: [coordinatorId], references: [id], onDelete: Cascade)
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([coordinatorId, subjectId])
  @@map("coordinator_subject_assignments")
}

// Vincula un coordinador con los docentes que supervisa
model CoordinatorAssignment {
  id            String   @id @default(uuid())
  coordinatorId String
  teacherId     String
  createdAt     DateTime @default(now())

  coordinator User @relation("CoordinatorTeachers", fields: [coordinatorId], references: [id], onDelete: Cascade)
  teacher     User @relation("TeacherCoordinators", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([coordinatorId, teacherId])
  @@index([teacherId])
  @@map("coordinator_assignments")
}

// Registro de revisión de un PUM por parte de un coordinador
model PlanReview {
  id              String       @id @default(uuid())
  planificationId String       @unique
  coordinatorId   String
  status          ReviewStatus @default(IN_REVIEW)
  sectionStates   Json         @default("{}") // Record<SectionKey, { approved: boolean; comment: string|null }>
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  planification Planification @relation(fields: [planificationId], references: [id], onDelete: Cascade)
  coordinator   User          @relation("CoordinatorReviews", fields: [coordinatorId], references: [id], onDelete: Restrict)

  @@index([coordinatorId])
  @@map("plan_reviews")
}

// Registro de auditoría: cada evento relevante del ciclo de vida de un PUM
model PlanAuditEvent {
  id              String   @id @default(uuid())
  planificationId String
  actorId         String?
  actorName       String?
  actorRole       String? // "TEACHER" | "COORDINATOR" | "ADMIN" | "SYSTEM"
  eventType       String // Ver AuditEventType en audit.service.ts
  sectionKey      String?
  sectionLabel    String?
  comment         String?  @db.Text
  createdAt       DateTime @default(now())

  planification Planification @relation(fields: [planificationId], references: [id], onDelete: Cascade)
  actor         User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([planificationId, createdAt])
  @@map("plan_audit_events")
}

// =============================================================
// SUPERADMIN — Auditoría de usuarios, sesiones y acciones del sistema
// =============================================================

// Registro de eventos sobre usuarios, accesos y acciones administrativas.
// Separado de PlanAuditEvent (que cubre solo el ciclo de vida de PUMs).
model UserAuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Actor que ejecuta la acción
  actorId    String?
  actorEmail String?
  actorRole  String?
  actorIp    String?

  // Tipo de evento y resultado
  eventType String // Ver USER_AUDIT_EVENT en user-audit.service.ts
  result    String @default("SUCCESS") // "SUCCESS" | "FAILURE"

  // Entidad afectada (puede ser distinta al actor)
  targetId    String?
  targetEmail String?
  targetRole  String?

  // Datos extra de contexto (endpoint, mensaje de error, etc.)
  metadata Json?

  actor  User? @relation("UserAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  target User? @relation("UserAuditTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([targetId])
  @@index([eventType])
  @@map("user_audit_logs")
}

// =============================================================
// SUPERADMIN — Configuración global del sistema
// =============================================================

// Fila única (id fijo "singleton") con ajustes globales del sistema.
// Hoy solo tiene el modo mantenimiento; futuros ajustes globales pueden
// agregarse como columnas nuevas de esta misma fila.
model SystemSetting {
  id                     String    @id @default("singleton")
  maintenanceModeEnabled Boolean   @default(false)
  maintenanceMessage     String?
  maintenanceEnabledAt   DateTime?
  maintenanceEnabledBy   String? // userId del SuperAdmin que activó/desactivó
  updatedAt              DateTime  @updatedAt

  enabledBy User? @relation("MaintenanceEnabledBy", fields: [maintenanceEnabledBy], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

// =============================================================
// SUPERADMIN — Monitoreo de errores del sistema
// =============================================================

// Errores capturados en producción: excepciones no controladas,
// fallos de integraciones externas (FTP, exportación), etc.
model SystemErrorLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  level   String // "ERROR" | "WARN" | "INFO"
  source  String // módulo o ruta que originó el error
  message String  @db.Text
  stack   String? @db.Text

  // Contexto adicional: userId, planId, endpoint, input, etc.
  metadata Json?

  // Resolución
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  resolvedBy  String? // userId del SuperAdmin que lo resolvió
  resolveNote String?   @db.Text

  resolver User? @relation("ErrorResolvedBy", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([level, resolved])
  @@index([source])
  @@map("system_error_logs")
}

// =============================================================
// SEGURIDAD — Rate limiting via Postgres (sin dependencias externas)
// =============================================================

// Ventana fija por clave. Cada clave tiene un contador y la marca
// del inicio de la ventana actual. Si now - windowStart > window,
// se reinicia. Se usa para login y acciones administrativas sensibles.
model RateLimit {
  key         String   @id // ej. "login:user@email.com"
  windowStart DateTime
  count       Int      @default(1)

  @@index([windowStart])
  @@map("rate_limits")
}
